DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_erp"
ANTHROPIC_API_KEY=""
AI_AUTO_CONFIDENCE_THRESHOLD="0.9"
# /api/seed(データベースの初期化)を手動で実行するときの合言葉。最初の管理者の作成には不要。
SEED_SECRET=""
# スマレジ・プラットフォームAPI (スマレジ・デベロッパーズで作成したアプリの認証情報)。
# 未設定の間は /pos の同期がデモ取引で動作する。
SMAREGI_CONTRACT_ID=""
SMAREGI_CLIENT_ID=""
SMAREGI_CLIENT_SECRET=""
# サンドボックス環境(smaregi.dev)に接続する場合は "true"
SMAREGI_SANDBOX=""
# メール送信(請求書・見積書・督促の送付、パスワード再設定、毎朝のお知らせ)。すべて空ならテストモード(送らずに履歴へ記録だけ)。
# Gmail の場合: SMTP_HOST=smtp.gmail.com / SMTP_PORT=465 / SMTP_USER=Gmailアドレス / SMTP_PASS=アプリ パスワード(16文字)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# 送信元アドレス(SMTP では省略時 SMTP_USER。Resend を使う場合は必須)
MAIL_FROM=""
# Resend を使う場合(SMTP より優先度は低い)
RESEND_API_KEY=""
# メール本文のリンクに使うURL(省略時は Vercel の本番ドメイン)
APP_URL=""
# 毎朝の「やること」メール(Vercel Cron)を動かすための合言葉(20文字以上の好きな文字列)
CRON_SECRET=""
