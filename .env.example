DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_erp"
ANTHROPIC_API_KEY=""
AI_AUTO_CONFIDENCE_THRESHOLD="0.9"
# 最初の管理者を作るときに入力する合言葉(/api/seed の実行にも使う)。
# 本番では必須(未設定だと最初の管理者を作れない)。ローカル開発で未設定なら合言葉なしで作成できる。
