# スマレジ・プラットフォームAPI (スマレジ・デベロッパーズで作成したアプリの認証情報)。
# 未設定の間は /pos の同期がデモ取引で動作する。
SMAREGI_CONTRACT_ID=""
SMAREGI_CLIENT_ID=""
SMAREGI_CLIENT_SECRET=""
# サンドボックス環境(smaregi.dev)に接続する場合は "true"
SMAREGI_SANDBOX=""
