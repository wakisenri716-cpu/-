DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_erp"
ANTHROPIC_API_KEY=""
# AIアシスタントのモデル(任意。既定は claude-opus-5-5)と1日の質問回数の上限(任意。既定は100)
ANTHROPIC_ASSISTANT_MODEL=""
ASSISTANT_DAILY_LIMIT=""
AI_AUTO_CONFIDENCE_THRESHOLD="0.9"
# /api/seed(データベースの初期化)を手動で実行するときの合言葉。最初の管理者の作成には不要。
SEED_SECRET=""
# スマレジ・プラットフォームAPI (スマレジ・デベロッパーズで作成したアプリの認証情報)。
# 未設定の間は /pos の同期がデモ取引で動作する。
SMAREGI_CONTRACT_ID=""
SMAREGI_CLIENT_ID=""
SMAREGI_CLIENT_SECRET=""
# サンドボックス環境(smaregi.dev)に接続する場合は "true"
SMAREGI_SANDBOX=""
# メール送信(請求書・見積書・督促の送付、パスワード再設定、毎朝のお知らせ)。すべて空ならテストモード(送らずに履歴へ記録だけ)。
# Gmail の場合: SMTP_HOST=smtp.gmail.com / SMTP_PORT=465 / SMTP_USER=Gmailアドレス / SMTP_PASS=アプリ パスワード(16文字)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# 送信元アドレス(SMTP では省略時 SMTP_USER。Resend を使う場合は必須)
MAIL_FROM=""
# Resend を使う場合(SMTP より優先度は低い)
RESEND_API_KEY=""
# メール本文のリンクに使うURL(省略時は Vercel の本番ドメイン)
APP_URL=""
# 毎朝の「やること」メール(Vercel Cron)を動かすための合言葉(20文字以上の好きな文字列)
CRON_SECRET=""
# 利用規約・プライバシーポリシーに載せる運営者(このサービスを提供する事業者)の名前・連絡先・住所
SERVICE_OPERATOR_NAME=""
SERVICE_CONTACT_EMAIL=""
SERVICE_OPERATOR_ADDRESS=""
# 有料プラン(Stripe)。設定するまでは課金せず、全機能を無料で使える。手順は BILLING.md
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_LIGHT=""
STRIPE_PRICE_STANDARD=""
# AI持ち込み(会社が自分のAIのキーを使う・割安)の価格
STRIPE_PRICE_LIGHT_BYO=""
STRIPE_PRICE_STANDARD_BYO=""
# 会社が登録したAIのキーを暗号化する合言葉(32文字以上。一度決めたら変えない。省略時は DATABASE_URL から作る)
AI_KEY_SECRET=""
# お金をもらわない会社(運営者の会社など)の管理者のメールアドレス(カンマ区切り)
BILLING_FREE_EMAILS=""
# 画面に出す月額(税込)。省略時はAI込み ライト 2980・スタンダード 6980、AI持ち込み ライト 1980・スタンダード 4980
PRICE_LIGHT_YEN=""
PRICE_STANDARD_YEN=""
PRICE_LIGHT_BYO_YEN=""
PRICE_STANDARD_BYO_YEN=""""
# 運営者メニュー(/operator: 登録した会社・売上見込み・無料期間の延長・本番のエラー)を使う人のメールアドレス(カンマ区切り)
OPERATOR_EMAILS=""
# Stripe なしで新規登録だけ受け付けるとき "true"
ALLOW_SIGNUP=""
# 特定商取引法に基づく表記: 運営統括責任者・電話番号(空なら「請求があれば開示」)
SERVICE_OPERATOR_REPRESENTATIVE=""
SERVICE_PHONE=""
