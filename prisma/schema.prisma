generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ExpenseReportStatus {
  DRAFT
  SUBMITTED
  AUTO_APPROVED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InvoiceDirection {
  ISSUED
  RECEIVED
}

enum InvoiceStatus {
  DRAFT
  PENDING_REVIEW
  CONFIRMED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum SourceType {
  EXPENSE_ITEM
  INVOICE
  PAYMENT
  FIXED_ASSET
  POS_SALE
  INVENTORY
  MANUAL
  BANK
  PAYROLL
  REIMBURSEMENT
  RECURRING
  IMPORT
}

enum QuoteStatus {
  OPEN
  INVOICED
  CANCELLED
}

// 取引先のインボイス登録: 登録あり / 登録なし(免税事業者など。仕入税額控除は経過措置の割合だけ)
enum VendorInvoiceStatus {
  REGISTERED
  NOT_REGISTERED
}

// 発注書: 発注済み → 検収済み(受け取った請求書として買掛金を計上) / 取消
enum PurchaseOrderStatus {
  OPEN
  RECEIVED
  CANCELLED
}

enum BankTransactionStatus {
  PENDING
  POSTED
  MATCHED
  IGNORED
}

enum StockMovementType {
  PURCHASE
  ISSUE
  STOCKTAKE
}

enum PosProvider {
  SMAREGI
  AIRREGI
}

enum AiExtractionStatus {
  AUTO_APPLIED
  NEEDS_REVIEW
  REJECTED
  CORRECTED
}

enum JournalEntryStatus {
  AUTO_POSTED
  PENDING_REVIEW
  POSTED_MANUALLY
  VOID
}

model Company {
  id               String   @id @default(cuid())
  name             String
  fiscalYearStartMonth Int  @default(4)
  // 発行する請求書に載せる情報(適格請求書発行事業者の登録番号など)
  registrationNumber String?
  address          String?
  phone            String?
  bankAccount      String?
  invoiceNote      String?
  // この日までの帳簿は締め済み(この日以前の日付の仕訳は、データベースのトリガーで追加・変更・削除できない)
  booksClosedThrough DateTime?
  // 経費精算を「申請→承認」してから精算する(オンにすると、承認されていない経費精算は精算できない)
  expenseApprovalRequired Boolean @default(false)
  // 消費税の計算方法: GENERAL(原則課税) / SIMPLIFIED(簡易課税) / TWENTY_PERCENT(2割特例)
  consumptionTaxMethod  String  @default("GENERAL")
  // 簡易課税の事業区分(1〜6種)
  simplifiedBusinessType Int    @default(5)
  // 経費1件あたりの上限額(これを超える明細は精算・承認の画面で「上限超え」と表示する)。空なら上限なし
  expenseItemLimit       Int?
  // メールの返信先(請求書などを送るときの Reply-To と、本文の署名に使う)
  email                  String?
  // 毎朝、管理者に「やること」をメールで知らせる
  dailyDigest            Boolean @default(false)
  // 給与計算の保険料率(単位: 0.001%。9910 = 9.910%)。都道府県・年度で変わるので画面から直せる
  payrollPrefecture      String  @default("東京都")
  payrollHealthRate      Int     @default(9910)
  payrollCareRate        Int     @default(1590)
  payrollPensionRate     Int     @default(18300)
  payrollEmploymentRate  Int     @default(550)
  // 36協定: 起算月と、時間外労働の上限(時間)。原則は月45時間・年360時間
  overtimeStartMonth     Int     @default(4)
  overtimeMonthlyLimit   Int     @default(45)
  overtimeYearlyLimit    Int     @default(360)
  // 安全の設定(会社ごと)
  // 全員に2段階認証を必須にする(設定していない人は、設定するまでアカウント画面しか使えない)
  require2fa             Boolean @default(false)
  // 操作しないまま、この分数が過ぎたら自動でログアウトする(空なら30日)
  sessionIdleMinutes     Int?
  // この会社を開ける IP アドレス(1行に1つ、CIDR可。空なら制限なし)
  allowedIps             String?
  // 新しい端末からログインしたら、本人にメールで知らせる
  loginAlert             Boolean @default(false)
  // 振込データ(全銀フォーマット)の振込元: { requesterCode, requesterName, bankCode, bankName, branchCode, branchName, accountType, accountNumber }
  transferSource         Json?
  // 源泉所得税・住民税の納付: 給料を働いた月の翌月に払う / 納期の特例(源泉所得税は年2回、住民税は年2回)
  salaryPaidNextMonth    Boolean @default(true)
  withholdingSpecial     Boolean @default(false)
  residentTaxSpecial     Boolean @default(false)
  // 労働条件通知書に入れる会社の決まり(就業の場所・休日・賃金の締切日と支払日・相談窓口など)
  laborDefaults          Json?
  // 月次決算チェックリストに会社で足した確認項目(文字列の配列)
  closeChecklist         Json?
  // 工数の標準の時間単価(円)。スタッフの時給がひも付いていない人の労務費に使う
  laborCostRate          Int?
  // 代表者名(書類に載せる)
  representative         String?
  // 最初の会社情報の入力(ようこそ画面)を済ませた日時。null なら管理者のログイン時に入力を案内する
  onboardedAt            DateTime?
  createdAt        DateTime @default(now())

  users            User[]
  accounts         Account[]
  vendors          Vendor[]
  customers        Customer[]
  expenseReports   ExpenseReport[]
  invoices         Invoice[]
  payments         Payment[]
  fixedAssets      FixedAsset[]
  posSales         PosSale[]
  products         Product[]
  bankTransactions BankTransaction[]
  staff            Staff[]
  shifts           Shift[]
  timeRecords      TimeRecord[]
  payrollRuns      PayrollRun[]
  journalEntries   JournalEntry[]
  aiExtractions    AiExtraction[]
  automationRules  AutomationRule[]
  quotes           Quote[]
  purchaseOrders   PurchaseOrder[]
  budgets          Budget[]
  recurringInvoices RecurringInvoice[]
  departments      Department[]
  projects         Project[]
  cashAdvances     CashAdvance[]
  announcements    Announcement[]
  deals            Deal[]
  equipment        Equipment[]
  workLogs         WorkLog[]
  monthlyCloseChecks MonthlyCloseCheck[]
  journalTemplates JournalTemplate[]
  emailLogs        EmailLog[]
  bankAccounts     BankAccount[]
  leaveGrants      LeaveGrant[]
  leaveTaken       LeaveTaken[]
  approvalRequests ApprovalRequest[]
  approvalRoutes   ApprovalRoute[]
  members          CompanyMember[]
  taxRemittances   TaxRemittance[]
  bonusRuns        BonusRun[]
  folders          Folder[]
  storedFiles      StoredFile[]
  recurringEntries RecurringEntry[]
  auditLogs        AuditLog[]
}

model User {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  email         String   @unique
  role          UserRole @default(EMPLOYEE)
  passwordHash  String?
  active        Boolean  @default(true)
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  // 2段階認証(認証アプリの6桁コード)。totpSecret は有効化済みの鍵、totpPendingSecret は設定途中の鍵(Base32)。
  totpEnabled       Boolean  @default(false)
  totpSecret        String?
  totpPendingSecret String?
  // 同じコードを2回使わせないため、最後に受け付けた30秒区切りの番号
  totpLastStep      Int?
  // 回復コード(SHA-256 のハッシュを JSON 配列で保存。使ったものは消す)
  recoveryCodes     String?
  createdAt     DateTime @default(now())

  expenseReports ExpenseReport[]
  cashAdvances   CashAdvance[]
  // 利用規約・プライバシーポリシーに同意した日時と、同意した版
  termsAcceptedAt DateTime?
  termsVersion    String?
  announcementReads AnnouncementRead[]
  equipmentLoans  EquipmentLoan[]
  workLogs        WorkLog[]
  sessions       Session[]
  passwordResets PasswordReset[]
  staffs         Staff[]
  requests       ApprovalRequest[]
  memberships    CompanyMember[]
}

// ログインセッション。ブラウザのクッキーには推測できないランダムなトークンだけを入れ、
// データベースにはそのハッシュを保存する(DBが漏れてもセッションを乗っ取れないようにする)。
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // このログインで開いている会社(空ならユーザーの最初の会社)
  companyId String?
  expiresAt DateTime
  // ログイン中の端末の一覧に出すための情報
  userAgent  String?
  lastSeenAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  code          String
  name          String
  category      AccountCategory
  isTaxable     Boolean         @default(false)
  // 使わなくなった科目は、仕訳の入力画面の選択肢から隠す(過去の仕訳・帳票には残る)
  hidden        Boolean         @default(false)
  createdAt     DateTime        @default(now())

  expenseItems       ExpenseItem[]
  journalLines       JournalLine[]
  vendorsAsDefault   Vendor[]        @relation("VendorDefaultAccount")
  budgets            Budget[]
  recurringLines     RecurringLine[]
  bankAccount        BankAccount?

  @@unique([companyId, code])
}

model Vendor {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  name                  String
  defaultExpenseAccountId String?
  defaultExpenseAccount  Account? @relation("VendorDefaultAccount", fields: [defaultExpenseAccountId], references: [id])
  // 支払の振込先(形は Staff.payeeAccount と同じ)
  payeeAccount          Json?
  // 支払調書・宛名に使う住所
  address               String?
  // 住所録(送付状・封筒・宛名ラベル、請求書などの宛先に使う)
  postalCode            String?
  department            String?
  contactName           String?
  // 敬称: 御中 か 様(担当者名があるときは担当者に「様」)
  honorific             String?
  phone                 String?
  // インボイス(適格請求書発行事業者)の登録。null は未確認
  invoiceStatus         VendorInvoiceStatus?
  registrationNumber    String?
  createdAt             DateTime @default(now())

  expenseItems  ExpenseItem[]
  invoices      Invoice[]
  purchaseOrders PurchaseOrder[]
}

model Customer {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  // 請求書・見積書をメールで送るときの宛先(前回入力したものを覚えておく)
  email      String?
  address    String?
  // 住所録(送付状・封筒・宛名ラベル、請求書などの宛先に使う)
  postalCode  String?
  department  String?
  contactName String?
  // 敬称: 御中 か 様(担当者名があるときは担当者に「様」)
  honorific   String?
  phone       String?
  createdAt  DateTime @default(now())

  invoices   Invoice[]
  quotes     Quote[]
}

model ExpenseReport {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  employeeId    String
  employee      User                @relation(fields: [employeeId], references: [id])
  status        ExpenseReportStatus @default(DRAFT)
  totalAmount   Int                 @default(0)
  submittedAt   DateTime?
  // 立替えた本人へ精算(振込など)した日と、その「未払金 / 普通預金」の仕訳
  reimbursedAt         DateTime?
  reimbursementEntryId String?       @unique
  reimbursementEntry   JournalEntry? @relation("ExpenseReimbursement", fields: [reimbursementEntryId], references: [id])
  // 仮払金と相殺して精算したときの仮払金
  cashAdvance          CashAdvance?
  // 承認フロー: DRAFT(作成中) / SUBMITTED(申請中) / APPROVED(承認済み) / RETURNED(差戻し)
  approvalStatus String    @default("DRAFT")
  approvedAt     DateTime?
  approvedByName String?
  returnComment  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         ExpenseItem[]
}

model ExpenseItem {
  id               String        @id @default(cuid())
  expenseReportId  String
  expenseReport    ExpenseReport @relation(fields: [expenseReportId], references: [id])
  description      String
  amount           Int
  expenseDate      DateTime
  vendorId         String?
  vendor           Vendor?       @relation(fields: [vendorId], references: [id])
  accountId        String?
  account          Account?      @relation(fields: [accountId], references: [id])
  receiptImageUrl  String?
  // 登録したときのレシート画像の SHA-256(DBのトリガーで自動で入れる。改ざんチェックに使う)
  receiptSha256    String?
  aiExtractionId   String?       @unique
  aiExtraction     AiExtraction? @relation(fields: [aiExtractionId], references: [id])
  journalEntryId   String?       @unique
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt        DateTime      @default(now())
}

model Invoice {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  direction       InvoiceDirection
  status          InvoiceStatus     @default(DRAFT)
  invoiceNumber   String?
  // メールで送った相手がログインせずに見られる共有リンクの鍵(送るときに作る)
  shareToken      String?           @unique
  // 訂正版の請求書なら、訂正した元の請求書(元の請求書は「取消」になり、入金・共有リンクは訂正版に引き継ぐ)
  correctsInvoiceId String?         @unique
  correctsInvoice   Invoice?        @relation("InvoiceCorrection", fields: [correctsInvoiceId], references: [id])
  correctedBy       Invoice?        @relation("InvoiceCorrection")
  correctionReason  String?
  vendorId        String?
  vendor          Vendor?           @relation(fields: [vendorId], references: [id])
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  issueDate       DateTime?
  dueDate         DateTime?
  subtotalAmount  Int               @default(0)
  taxAmount       Int               @default(0)
  totalAmount     Int               @default(0)
  sourceFileUrl   String?
  sourceSha256    String?
  aiExtractionId  String?           @unique
  aiExtraction    AiExtraction?     @relation(fields: [aiExtractionId], references: [id])
  journalEntryId  String?           @unique
  journalEntry    JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  payments         Payment[]
  bankTransactions BankTransaction[]
  lines            InvoiceLine[]
  notes            String?
  quote            Quote?
  purchaseOrder    PurchaseOrder?
  recurringTemplates RecurringInvoice[] @relation("RecurringInvoiceTemplate")
  recurringRun     RecurringInvoiceRun?
}

// 毎月の定額請求。ひな形の請求書(宛先・明細・備考)を写した請求書を、毎月決まった日に作る。
model RecurringInvoice {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  name              String
  templateInvoiceId String
  templateInvoice   Invoice  @relation("RecurringInvoiceTemplate", fields: [templateInvoiceId], references: [id])
  // 請求日(1〜28日、0 = 月末)
  issueDay          Int
  // 支払期限: 請求日から何日後か。null なら翌月末
  dueDays           Int?
  startMonth        String
  endMonth          String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  runs              RecurringInvoiceRun[]
}

model RecurringInvoiceRun {
  id                 String           @id @default(cuid())
  recurringInvoiceId String
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  month              String
  invoiceId          String           @unique
  invoice            Invoice          @relation(fields: [invoiceId], references: [id])
  createdAt          DateTime         @default(now())

  @@unique([recurringInvoiceId, month])
}

// 見積書。仕訳は作らず、「請求書に変換」したときに請求書(と売上の仕訳)を作る。
model Quote {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  quoteNumber    String
  shareToken     String?     @unique
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  issueDate      DateTime
  validUntil     DateTime
  subtotalAmount Int
  taxAmount      Int
  totalAmount    Int
  notes          String?
  status         QuoteStatus @default(OPEN)
  invoiceId      String?     @unique
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime    @default(now())

  lines          QuoteLine[]

  @@unique([companyId, quoteNumber])
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder   Int
  description String
  quantity    Float
  unit        String?
  unitPrice   Int
  taxRate     Int
  amount      Int
}

// 発注書(仕入先への注文)。仕訳は作らず、検収したときに受け取った請求書(買掛金)を作る。
model PurchaseOrder {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id])
  orderNumber    String
  vendorId       String
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  issueDate      DateTime
  deliveryDate   DateTime
  deliveryPlace  String?
  paymentTerms   String?
  subtotalAmount Int
  taxAmount      Int
  totalAmount    Int
  notes          String?
  status         PurchaseOrderStatus @default(OPEN)
  receivedDate   DateTime?
  invoiceId      String?             @unique
  invoice        Invoice?            @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime            @default(now())

  lines          PurchaseOrderLine[]

  @@unique([companyId, orderNumber])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sortOrder       Int
  description     String
  quantity        Float
  unit            String?
  unitPrice       Int
  taxRate         Int
  amount          Int
}

// 勘定科目ごとの年間予算(fiscalYear は期首の年。4月始まりなら 2026年4月〜2027年3月 が 2026)
model Budget {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  fiscalYear Int
  accountId  String
  account    Account @relation(fields: [accountId], references: [id])
  amount     Int

  @@unique([companyId, fiscalYear, accountId])
}

// アプリで作成した請求書の明細。税率ごとに合計してから消費税の端数を処理する(インボイス制度のルール)。
model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder   Int
  description String
  quantity    Float
  unit        String?
  unitPrice   Int
  taxRate     Int
  amount      Int
}

model Payment {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  amount         Int
  paymentDate    DateTime
  journalEntryId String?      @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  // 報酬の源泉徴収(買掛金 / 預り金)。支払うお金ではないが、請求書の残りから差し引く
  withholding     Boolean     @default(false)
  // 源泉徴収の対象にした報酬の額(消費税が分かれていれば税抜)と、報酬の種類
  withholdingBase Int?
  feeCategory     String?
  createdAt      DateTime     @default(now())
}

model FixedAsset {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  acquisitionDate DateTime
  acquisitionCost Int
  residualValue   Int      @default(1)
  usefulLifeYears Int
  journalEntryId  String?  @unique
  journalEntry    JournalEntry? @relation("FixedAssetAcquisition", fields: [journalEntryId], references: [id])
  // 除却・売却した日と売却額(除却なら0)、その仕訳
  disposedAt      DateTime?
  disposalPrice   Int?
  disposalEntryId String?  @unique
  disposalEntry   JournalEntry? @relation("FixedAssetDisposal", fields: [disposalEntryId], references: [id])
  createdAt       DateTime @default(now())

  depreciationEntries DepreciationEntry[]
}

model DepreciationEntry {
  id             String       @id @default(cuid())
  fixedAssetId   String
  fixedAsset     FixedAsset   @relation(fields: [fixedAssetId], references: [id])
  period         String
  amount         Int
  journalEntryId String?      @unique
  journalEntry   JournalEntry? @relation("DepreciationPosting", fields: [journalEntryId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([fixedAssetId, period])
}

// POSレジ(スマレジ/Airレジ)の1会計。仕訳は営業日単位でまとめて切るため、
// 複数の PosSale が同じ JournalEntry を指す。
model PosSale {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  provider       PosProvider
  externalId     String
  soldAt         DateTime
  businessDate   String
  storeName      String?
  totalAmount    Int
  taxAmount      Int
  cashAmount     Int
  cashlessAmount Int
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime      @default(now())

  @@unique([companyId, provider, externalId])
  @@index([companyId, businessDate])
}

// 在庫は移動平均法で評価する。単価ではなく在庫金額の合計を持つことで、
// 出庫のたびに端数が積み上がってズレるのを防いでいる。
model Product {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  code           String?
  name           String
  unit           String   @default("個")
  quantityOnHand Int      @default(0)
  inventoryValue Int      @default(0)
  // 在庫数がこの数以下になったら発注を促す(未設定なら在庫切れのときだけ)
  reorderPoint   Int?
  createdAt      DateTime @default(now())

  movements      StockMovement[]

  @@unique([companyId, name])
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  type           StockMovementType
  date           DateTime
  quantity       Int
  amount         Int
  memo           String?
  journalEntryId String?           @unique
  journalEntry   JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([productId, date])
}

// 銀行明細の1行。fingerprint は同じCSVを再アップロードしても二重に取り込まないためのキー。
// 請求書と金額が一致して消込んだ行(MATCHED)は、入金・支払の仕訳を journalEntry として参照する。
model BankTransaction {
  id                   String                @id @default(cuid())
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  date                 DateTime
  description          String
  withdrawal           Int                   @default(0)
  deposit              Int                   @default(0)
  balance              Int?
  fingerprint          String
  // どの口座・カードの明細か(空なら最初の「普通預金」)
  bankAccountId        String?
  bankAccount          BankAccount?          @relation(fields: [bankAccountId], references: [id])
  status               BankTransactionStatus @default(PENDING)
  suggestedAccountCode String?
  confidence           Float?
  suggestionSource     String?
  suggestionReason     String?
  matchedInvoiceId     String?
  matchedInvoice       Invoice?              @relation(fields: [matchedInvoiceId], references: [id])
  journalEntryId       String?               @unique
  journalEntry         JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  createdAt            DateTime              @default(now())

  @@unique([companyId, fingerprint])
  @@index([companyId, status, date])
}

// シフトに入るスタッフ。ログインするユーザーとは別で、アカウントを持たないアルバイトも登録できる。
model Staff {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  hourlyWage  Int
  active      Boolean  @default(true)
  // タイムカードの暗証番号(ハッシュ)。設定されていれば打刻のたびに入力を求める。
  pinHash     String?
  pinFailures Int      @default(0)
  pinLockedUntil DateTime?
  // 給与計算の設定(源泉所得税・社会保険料の控除に使う)
  dependents          Int      @default(0)      // 扶養親族等の数(源泉所得税)
  taxColumn           String   @default("KOU")  // KOU(甲欄: 扶養控除等申告書あり) / OTSU(乙欄)
  socialInsurance     Boolean  @default(false)  // 健康保険・厚生年金に加入
  careInsurance       Boolean  @default(false)  // 介護保険(40〜64歳)
  employmentInsurance Boolean  @default(false)  // 雇用保険に加入
  standardMonthly     Int?                      // 標準報酬月額(空なら毎月の支給額から目安で決める)
  commuteAllowance    Int      @default(0)      // 通勤手当(月額・非課税)
  residentTax         Int      @default(0)      // 住民税(特別徴収の月額)
  // 有給休暇の設定。入社日から法律どおりの日数を自動で付与する
  hireDate            DateTime?                 // 入社日(空なら自動付与しない)
  weeklyDays          Int      @default(5)      // 週の所定労働日数(4日以下なら比例付与)
  scheduledMinutes    Int      @default(480)    // 1日の所定労働時間(分)。有給1日分の賃金に使う
  createdAt   DateTime @default(now())

  shifts      Shift[]
  timeRecords TimeRecord[]
  leaveGrants LeaveGrant[]
  leaveTaken  LeaveTaken[]
  // 労働者名簿・労働条件通知書のための情報(ふりがな・生年月日・住所・雇用形態・業務・勤務時間・退職日など)
  profile     Json?
  // 給与の振込先: { bankCode, bankName, branchCode, branchName, accountType, accountNumber, holder }(名前はすべて半角カナ)
  payeeAccount Json?
  // ログインユーザーとのひも付け(本人が有給の申請などをするため)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  requests    ApprovalRequest[]

  @@unique([companyId, name])
  @@unique([companyId, userId])
}

// 時刻は勤務日の0時からの分数。日付をまたぐ勤務は endMinutes が1440(24:00)を超える。
model Shift {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id])
  date         DateTime
  startMinutes Int
  endMinutes   Int
  breakMinutes Int      @default(0)
  note         String?
  createdAt    DateTime @default(now())

  @@index([companyId, date])
}

// 出退勤の打刻。date は出勤した日(日本時間)で、日付をまたいで退勤しても出勤日の勤務として扱う。
// clockOut が空のあいだは勤務中、breakStartedAt が入っているあいだは休憩中。
model TimeRecord {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  staffId        String
  staff          Staff     @relation(fields: [staffId], references: [id])
  date           DateTime
  clockIn        DateTime
  clockOut       DateTime?
  breakMinutes   Int       @default(0)
  breakStartedAt DateTime?
  edited         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([companyId, date])
  @@index([staffId, clockOut])
}

model PayrollRun {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  month          String
  totalAmount    Int
  // 計上したときの控除の計算結果(あとで設定を変えても、計上済みの明細は変わらないように残す)
  details        Json?
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([companyId, month])
}

model AiExtraction {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id])
  sourceType          SourceType
  rawResponse         Json
  confidence          Float
  suggestedAccountCode String?
  status              AiExtractionStatus  @default(NEEDS_REVIEW)
  createdAt           DateTime            @default(now())

  expenseItem  ExpenseItem?
  invoice      Invoice?
}

model JournalEntry {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  date         DateTime
  description  String
  sourceType   SourceType
  status       JournalEntryStatus @default(PENDING_REVIEW)
  createdByAi  Boolean            @default(false)
  // 部門・店舗(任意)。部門別の損益を出すために仕訳ごとに付ける。
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  // 案件(プロジェクト)。案件ごとの売上・原価・利益を出すために付ける
  projectId    String?
  project      Project?           @relation(fields: [projectId], references: [id])
  createdAt    DateTime           @default(now())

  lines             JournalLine[]
  expenseItem       ExpenseItem?
  invoice           Invoice?
  payment           Payment?
  fixedAsset        FixedAsset?        @relation("FixedAssetAcquisition")
  depreciationEntry DepreciationEntry? @relation("DepreciationPosting")
  posSales          PosSale[]
  stockMovement     StockMovement?
  bankTransaction   BankTransaction?
  payrollRun        PayrollRun?
  bonusRun          BonusRun?
  reimbursedReport  ExpenseReport?     @relation("ExpenseReimbursement")
  cashAdvanceIssue  CashAdvance?       @relation("CashAdvanceIssue")
  cashAdvanceSettle CashAdvance?       @relation("CashAdvanceSettle")
  disposedAsset     FixedAsset?        @relation("FixedAssetDisposal")
  recurringPosting  RecurringPosting?
}

// 毎月決まった日に同じ仕訳を記帳する定期取引(家賃・リース料・借入金の返済など)
model RecurringEntry {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String
  // 1〜28日、または 0 = 月末
  dayOfMonth  Int
  startMonth  String
  endMonth    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  lines       RecurringLine[]
  postings    RecurringPosting[]
}

model RecurringLine {
  id               String         @id @default(cuid())
  recurringEntryId String
  recurringEntry   RecurringEntry @relation(fields: [recurringEntryId], references: [id], onDelete: Cascade)
  sortOrder        Int
  accountId        String
  account          Account        @relation(fields: [accountId], references: [id])
  debit            Int
  credit           Int
}

// 定期取引をどの月に記帳したか。同じ月に2回記帳しないための記録。
model RecurringPosting {
  id               String         @id @default(cuid())
  recurringEntryId String
  recurringEntry   RecurringEntry @relation(fields: [recurringEntryId], references: [id], onDelete: Cascade)
  month            String
  journalEntryId   String         @unique
  journalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([recurringEntryId, month])
}

// 操作ログ(誰が・いつ・何をしたか)
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  userName  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Int          @default(0)
  credit         Int          @default(0)
  memo           String?
}

model AutomationRule {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  sourceType     SourceType
  minConfidence  Float      @default(0.9)
  maxAutoAmount  Int?
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())

  @@unique([companyId, sourceType])
}

// 部門・店舗。仕訳に付けておくと、部門別の損益計算書を出せる。
// 月次決算チェックリストで、人が確かめて付けたチェック(自動で判定する項目は保存しない)
model MonthlyCloseCheck {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  month     String
  key       String
  checkedBy String
  checkedAt DateTime @default(now())

  @@unique([companyId, month, key])
}

// 備品(パソコン・スマホ・鍵など)と貸出の記録
enum EquipmentStatus {
  ACTIVE
  BROKEN
  DISPOSED
}

model Equipment {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  code         String?
  name         String
  category     String?
  serialNumber String?
  location     String?
  purchaseDate DateTime?
  price        Int?
  status       EquipmentStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime        @default(now())

  loans        EquipmentLoan[]

  @@unique([companyId, code])
}

model EquipmentLoan {
  id           String    @id @default(cuid())
  equipmentId  String
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  // 借りた人(メンバーならユーザー、ほかは名前だけ)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  borrowerName String
  lentAt       DateTime
  dueDate      DateTime?
  returnedAt   DateTime?
  notes        String?

  @@index([equipmentId, returnedAt])
}

// 商談(受注までの見込み)。見込み → 提案中 → 見積提出 → 受注 / 失注
enum DealStage {
  LEAD
  PROPOSAL
  QUOTED
  WON
  LOST
}

model Deal {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  title          String
  customerName   String
  amount         Int       @default(0)
  stage          DealStage @default(LEAD)
  // 受注の確度(%)。空なら段階ごとの目安を使う
  probability    Int?
  expectedClose  DateTime?
  nextAction     String?
  nextActionDate DateTime?
  ownerName      String?
  notes          String?
  lostReason     String?
  closedAt       DateTime?
  // 受注したときに作った案件(案件別損益)
  projectId      String?   @unique
  project        Project?  @relation(fields: [projectId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, stage])
}

// 社内のお知らせ(全員が見る掲示板)。読んだ人を記録して、誰がまだ読んでいないかを確かめられる
model Announcement {
  id         String             @id @default(cuid())
  companyId  String
  company    Company            @relation(fields: [companyId], references: [id])
  title      String
  body       String
  pinned     Boolean            @default(false)
  authorName String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  reads      AnnouncementRead[]

  @@index([companyId, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

// 仮払金: 出張などの前に従業員へ先に渡すお金。あとで経費精算と相殺し、差額を返してもらうか払う
enum CashAdvanceStatus {
  OPEN
  SETTLED
  CANCELLED
}

model CashAdvance {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        User              @relation(fields: [employeeId], references: [id])
  purpose         String
  amount          Int
  paidDate        DateTime
  payFrom         String
  status          CashAdvanceStatus @default(OPEN)
  issueEntryId    String            @unique
  issueEntry      JournalEntry      @relation("CashAdvanceIssue", fields: [issueEntryId], references: [id])
  // 精算: 相殺した経費精算(なければ全額返金)と、その仕訳
  expenseReportId String?           @unique
  expenseReport   ExpenseReport?    @relation(fields: [expenseReportId], references: [id])
  settleEntryId   String?           @unique
  settleEntry     JournalEntry?     @relation("CashAdvanceSettle", fields: [settleEntryId], references: [id])
  settledDate     DateTime?
  createdAt       DateTime          @default(now())
}

// 案件(プロジェクト・工事・受託など)。仕訳に付けて、案件ごとの損益を出す
model Project {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  name          String
  customerName  String?
  startDate     DateTime?
  endDate       DateTime?
  // 予算(受注額・原価の見込み。任意)
  budgetRevenue Int?
  budgetCost    Int?
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())

  journalEntries JournalEntry[]
  deal           Deal?
  workLogs       WorkLog[]

  @@unique([companyId, name])
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  journalEntries JournalEntry[]

  @@unique([companyId, name])
}

// よく使う仕訳のひな形(会社ごとに登録)。lines は [{ accountId, debit, credit, memo }] の JSON。
model JournalTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String
  lines       Json
  createdAt   DateTime @default(now())

  @@unique([companyId, name])
}

// 書類フォルダ。会社の書類(契約書・見積書のPDF・写真など)を入れておく場所。フォルダの中にフォルダも作れる。
model Folder {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  parentId  String?
  parent    Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Folder[]     @relation("FolderTree")
  files     StoredFile[]
  name      String
  createdAt DateTime     @default(now())

  @@index([companyId, parentId])
}

// フォルダに入れたファイル。中身は DB に保存する(1ファイル 4MB まで)。folderId が空ならいちばん上の階層。
model StoredFile {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  folderId       String?
  folder         Folder?  @relation(fields: [folderId], references: [id], onDelete: Restrict)
  name           String
  mimeType       String
  size           Int
  data           Bytes
  sha256         String?
  memo           String?
  uploadedByName String
  // 契約の満了日・更新日など(近づいたらダッシュボードとカレンダーでお知らせ)
  expiresOn      DateTime?
  createdAt      DateTime @default(now())

  @@index([companyId, folderId])
}

// 送ったメールの記録(テストモードで送らなかったものも残す)
model EmailLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  // INVOICE / QUOTE / REMINDER / PASSWORD_RESET / DIGEST / APPROVAL / TEST
  kind       String
  to         String
  subject    String
  body       String
  // SENT(送信済み) / FAILED(失敗) / TEST(テストモードのため送っていない)
  status     String
  error      String?
  relatedId  String?
  sentByName String
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
}

// パスワード再設定のリンク。鍵そのものは保存せず、ハッシュだけ持つ(1時間・1回だけ有効)
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 源泉所得税を手で直したとき(税額表と違う・乙欄など)の値。計上前だけ変えられる
model PayrollOverride {
  id        String   @id @default(cuid())
  companyId String
  staffId   String
  month     String
  incomeTax Int
  createdAt DateTime @default(now())

  @@unique([staffId, month])
  @@index([companyId, month])
}

// 訂正・削除の履歴(電子帳簿保存法の真実性の要件)。仕訳・証憑などが登録・変更・削除されるたびに、
// データベースのトリガーが変更前と変更後を自動で書き込む。この表の書き換え・削除はトリガーで禁止している。
model RecordHistory {
  id        BigInt   @id @default(autoincrement())
  companyId String?
  tableName String
  recordId  String
  // INSERT / UPDATE / DELETE
  action    String
  oldData   Json?
  newData   Json?
  changedAt DateTime @default(now())

  @@index([companyId, changedAt])
  @@index([tableName, recordId])
}

// 明細を取り込む銀行口座・クレジットカード。それぞれ専用の勘定科目(普通預金(〇〇)・未払金(〇〇カード))を持つ。
model BankAccount {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id])
  name         String
  // BANK(銀行口座) / CARD(クレジットカード)
  kind         String
  // この口座・カード専用の勘定科目
  accountId    String            @unique
  account      Account           @relation(fields: [accountId], references: [id])
  // カード: 銀行明細の摘要にこの文字があれば、そのカードの代金の引落しとみなす(例: ミツイスミトモカード)
  debitKeyword String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  transactions BankTransaction[]

  @@unique([companyId, name])
}

// 有給休暇の付与。auto は入社日から自動で付与したもの。日数は半日単位(halfDays = 日数×2)。付与から2年で時効。
model LeaveGrant {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  grantDate DateTime
  halfDays  Int
  auto      Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  @@unique([staffId, grantDate, auto])
  @@index([companyId])
}

// 有給休暇の取得。halfDays は 2(1日) か 1(半日)。bulk はこのシステムを使う前に取った分をまとめて登録したもの(給与には入れない)
model LeaveTaken {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  date      DateTime
  halfDays  Int
  bulk      Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  @@unique([staffId, date])
  @@index([companyId, date])
}

// 稟議・申請(有給休暇・購入・その他)。承認ルート(steps)は申請したときのものを残す。
model ApprovalRequest {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  // R-2026-0001 のような番号(会社ごと・年ごとの連番)
  number        String
  // LEAVE(有給休暇) / PURCHASE(購入・支払) / GENERAL(その他)
  kind          String
  title         String
  body          String           @default("")
  amount        Int?
  payee         String?
  leaveDate     DateTime?
  leaveHalfDays Int?
  staffId       String?
  staff         Staff?           @relation(fields: [staffId], references: [id])
  requesterId   String
  requester     User             @relation(fields: [requesterId], references: [id])
  requesterName String
  // PENDING(承認待ち) / APPROVED(承認) / REJECTED(差戻し) / WITHDRAWN(取下げ)
  status        String           @default("PENDING")
  // [{ userId: string | null(管理者のだれか), name: string }]
  steps         Json
  currentStep   Int              @default(0)
  leaveTakenId  String?
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  actions       ApprovalAction[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([requesterId])
}

// 稟議の回覧記録(申請・承認・差戻し・取下げ・コメント)
model ApprovalAction {
  id        String          @id @default(cuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step      Int
  userId    String?
  userName  String
  // SUBMIT / APPROVE / REJECT / WITHDRAW / COMMENT / SKIP
  action    String
  comment   String?
  createdAt DateTime        @default(now())

  @@index([requestId])
}

// 承認ルート。申請の種類(ALL は全部)と金額で選ぶ。approverIds の順に回す。
model ApprovalRoute {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  kind        String
  minAmount   Int      @default(0)
  approverIds String[]
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// 会社のメンバー。1人のユーザーが複数の会社に入れる(会社ごとに権限と利用停止を持つ)。
// User.companyId はログインしたときに最初に開く会社。
model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  role      UserRole @default(EMPLOYEE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

// 源泉所得税・住民税を納付した記録。period は「2026-09」(毎月)か「2026-H1」「2026-H2」(納期の特例)
model TaxRemittance {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  kind      String
  period    String
  amount    Int
  paidAt    DateTime
  createdAt DateTime @default(now())

  @@unique([companyId, kind, period])
}

// 賞与(ボーナス)の計上。details には計算した結果(人ごとの支給額・控除・差引支給額)をそのまま残す
model BonusRun {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  label          String
  payDate        DateTime
  total          Int
  details        Json
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([companyId, payDate])
}

// 日報(工数): 誰が・いつ・どの案件に・何分・何をしたか。案件の労務費(時間 × 単価)の目安に使う
model WorkLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime
  // 空なら社内の作業(会議・事務など)
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  minutes    Int
  task       String?
  // 記録したときの時間単価(円)
  hourlyCost Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId, date])
  @@index([userId, date])
}
