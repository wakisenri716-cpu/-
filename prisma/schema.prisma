generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ExpenseReportStatus {
  DRAFT
  SUBMITTED
  AUTO_APPROVED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InvoiceDirection {
  ISSUED
  RECEIVED
}

enum InvoiceStatus {
  DRAFT
  PENDING_REVIEW
  CONFIRMED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum SourceType {
  EXPENSE_ITEM
  INVOICE
  PAYMENT
  FIXED_ASSET
  POS_SALE
  INVENTORY
  MANUAL
  BANK
  PAYROLL
  REIMBURSEMENT
  RECURRING
  IMPORT
}

enum QuoteStatus {
  OPEN
  INVOICED
  CANCELLED
}

enum BankTransactionStatus {
  PENDING
  POSTED
  MATCHED
  IGNORED
}

enum StockMovementType {
  PURCHASE
  ISSUE
  STOCKTAKE
}

enum PosProvider {
  SMAREGI
  AIRREGI
}

enum AiExtractionStatus {
  AUTO_APPLIED
  NEEDS_REVIEW
  REJECTED
  CORRECTED
}

enum JournalEntryStatus {
  AUTO_POSTED
  PENDING_REVIEW
  POSTED_MANUALLY
  VOID
}

model Company {
  id               String   @id @default(cuid())
  name             String
  fiscalYearStartMonth Int  @default(4)
  // 発行する請求書に載せる情報(適格請求書発行事業者の登録番号など)
  registrationNumber String?
  address          String?
  phone            String?
  bankAccount      String?
  invoiceNote      String?
  createdAt        DateTime @default(now())

  users            User[]
  accounts         Account[]
  vendors          Vendor[]
  customers        Customer[]
  expenseReports   ExpenseReport[]
  invoices         Invoice[]
  payments         Payment[]
  fixedAssets      FixedAsset[]
  posSales         PosSale[]
  products         Product[]
  bankTransactions BankTransaction[]
  staff            Staff[]
  shifts           Shift[]
  timeRecords      TimeRecord[]
  payrollRuns      PayrollRun[]
  journalEntries   JournalEntry[]
  aiExtractions    AiExtraction[]
  automationRules  AutomationRule[]
  quotes           Quote[]
  budgets          Budget[]
  recurringEntries RecurringEntry[]
  auditLogs        AuditLog[]
}

model User {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  email         String   @unique
  role          UserRole @default(EMPLOYEE)
  passwordHash  String?
  active        Boolean  @default(true)
  failedLogins  Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())

  expenseReports ExpenseReport[]
  sessions       Session[]
}

// ログインセッション。ブラウザのクッキーには推測できないランダムなトークンだけを入れ、
// データベースにはそのハッシュを保存する(DBが漏れてもセッションを乗っ取れないようにする)。
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  code          String
  name          String
  category      AccountCategory
  isTaxable     Boolean         @default(false)
  createdAt     DateTime        @default(now())

  expenseItems       ExpenseItem[]
  journalLines       JournalLine[]
  vendorsAsDefault   Vendor[]        @relation("VendorDefaultAccount")
  budgets            Budget[]
  recurringLines     RecurringLine[]

  @@unique([companyId, code])
}

model Vendor {
  id                    String   @id @default(cuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  name                  String
  defaultExpenseAccountId String?
  defaultExpenseAccount  Account? @relation("VendorDefaultAccount", fields: [defaultExpenseAccountId], references: [id])
  createdAt             DateTime @default(now())

  expenseItems  ExpenseItem[]
  invoices      Invoice[]
}

model Customer {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  createdAt  DateTime @default(now())

  invoices   Invoice[]
  quotes     Quote[]
}

model ExpenseReport {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  employeeId    String
  employee      User                @relation(fields: [employeeId], references: [id])
  status        ExpenseReportStatus @default(DRAFT)
  totalAmount   Int                 @default(0)
  submittedAt   DateTime?
  // 立替えた本人へ精算(振込など)した日と、その「未払金 / 普通預金」の仕訳
  reimbursedAt         DateTime?
  reimbursementEntryId String?       @unique
  reimbursementEntry   JournalEntry? @relation("ExpenseReimbursement", fields: [reimbursementEntryId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         ExpenseItem[]
}

model ExpenseItem {
  id               String        @id @default(cuid())
  expenseReportId  String
  expenseReport    ExpenseReport @relation(fields: [expenseReportId], references: [id])
  description      String
  amount           Int
  expenseDate      DateTime
  vendorId         String?
  vendor           Vendor?       @relation(fields: [vendorId], references: [id])
  accountId        String?
  account          Account?      @relation(fields: [accountId], references: [id])
  receiptImageUrl  String?
  aiExtractionId   String?       @unique
  aiExtraction     AiExtraction? @relation(fields: [aiExtractionId], references: [id])
  journalEntryId   String?       @unique
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt        DateTime      @default(now())
}

model Invoice {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  direction       InvoiceDirection
  status          InvoiceStatus     @default(DRAFT)
  invoiceNumber   String?
  vendorId        String?
  vendor          Vendor?           @relation(fields: [vendorId], references: [id])
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id])
  issueDate       DateTime?
  dueDate         DateTime?
  subtotalAmount  Int               @default(0)
  taxAmount       Int               @default(0)
  totalAmount     Int               @default(0)
  sourceFileUrl   String?
  aiExtractionId  String?           @unique
  aiExtraction    AiExtraction?     @relation(fields: [aiExtractionId], references: [id])
  journalEntryId  String?           @unique
  journalEntry    JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  payments         Payment[]
  bankTransactions BankTransaction[]
  lines            InvoiceLine[]
  notes            String?
  quote            Quote?
}

// 見積書。仕訳は作らず、「請求書に変換」したときに請求書(と売上の仕訳)を作る。
model Quote {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id])
  quoteNumber    String
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  issueDate      DateTime
  validUntil     DateTime
  subtotalAmount Int
  taxAmount      Int
  totalAmount    Int
  notes          String?
  status         QuoteStatus @default(OPEN)
  invoiceId      String?     @unique
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime    @default(now())

  lines          QuoteLine[]

  @@unique([companyId, quoteNumber])
}

model QuoteLine {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder   Int
  description String
  quantity    Float
  unit        String?
  unitPrice   Int
  taxRate     Int
  amount      Int
}

// 勘定科目ごとの年間予算(fiscalYear は期首の年。4月始まりなら 2026年4月〜2027年3月 が 2026)
model Budget {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  fiscalYear Int
  accountId  String
  account    Account @relation(fields: [accountId], references: [id])
  amount     Int

  @@unique([companyId, fiscalYear, accountId])
}

// アプリで作成した請求書の明細。税率ごとに合計してから消費税の端数を処理する(インボイス制度のルール)。
model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder   Int
  description String
  quantity    Float
  unit        String?
  unitPrice   Int
  taxRate     Int
  amount      Int
}

model Payment {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  amount         Int
  paymentDate    DateTime
  journalEntryId String?      @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime     @default(now())
}

model FixedAsset {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  name            String
  acquisitionDate DateTime
  acquisitionCost Int
  residualValue   Int      @default(1)
  usefulLifeYears Int
  journalEntryId  String?  @unique
  journalEntry    JournalEntry? @relation("FixedAssetAcquisition", fields: [journalEntryId], references: [id])
  // 除却・売却した日と売却額(除却なら0)、その仕訳
  disposedAt      DateTime?
  disposalPrice   Int?
  disposalEntryId String?  @unique
  disposalEntry   JournalEntry? @relation("FixedAssetDisposal", fields: [disposalEntryId], references: [id])
  createdAt       DateTime @default(now())

  depreciationEntries DepreciationEntry[]
}

model DepreciationEntry {
  id             String       @id @default(cuid())
  fixedAssetId   String
  fixedAsset     FixedAsset   @relation(fields: [fixedAssetId], references: [id])
  period         String
  amount         Int
  journalEntryId String?      @unique
  journalEntry   JournalEntry? @relation("DepreciationPosting", fields: [journalEntryId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([fixedAssetId, period])
}

// POSレジ(スマレジ/Airレジ)の1会計。仕訳は営業日単位でまとめて切るため、
// 複数の PosSale が同じ JournalEntry を指す。
model PosSale {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id])
  provider       PosProvider
  externalId     String
  soldAt         DateTime
  businessDate   String
  storeName      String?
  totalAmount    Int
  taxAmount      Int
  cashAmount     Int
  cashlessAmount Int
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime      @default(now())

  @@unique([companyId, provider, externalId])
  @@index([companyId, businessDate])
}

// 在庫は移動平均法で評価する。単価ではなく在庫金額の合計を持つことで、
// 出庫のたびに端数が積み上がってズレるのを防いでいる。
model Product {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  code           String?
  name           String
  unit           String   @default("個")
  quantityOnHand Int      @default(0)
  inventoryValue Int      @default(0)
  createdAt      DateTime @default(now())

  movements      StockMovement[]

  @@unique([companyId, name])
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  type           StockMovementType
  date           DateTime
  quantity       Int
  amount         Int
  memo           String?
  journalEntryId String?           @unique
  journalEntry   JournalEntry?     @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([productId, date])
}

// 銀行明細の1行。fingerprint は同じCSVを再アップロードしても二重に取り込まないためのキー。
// 請求書と金額が一致して消込んだ行(MATCHED)は、入金・支払の仕訳を journalEntry として参照する。
model BankTransaction {
  id                   String                @id @default(cuid())
  companyId            String
  company              Company               @relation(fields: [companyId], references: [id])
  date                 DateTime
  description          String
  withdrawal           Int                   @default(0)
  deposit              Int                   @default(0)
  balance              Int?
  fingerprint          String
  status               BankTransactionStatus @default(PENDING)
  suggestedAccountCode String?
  confidence           Float?
  suggestionSource     String?
  suggestionReason     String?
  matchedInvoiceId     String?
  matchedInvoice       Invoice?              @relation(fields: [matchedInvoiceId], references: [id])
  journalEntryId       String?               @unique
  journalEntry         JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  createdAt            DateTime              @default(now())

  @@unique([companyId, fingerprint])
  @@index([companyId, status, date])
}

// シフトに入るスタッフ。ログインするユーザーとは別で、アカウントを持たないアルバイトも登録できる。
model Staff {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  hourlyWage  Int
  active      Boolean  @default(true)
  // タイムカードの暗証番号(ハッシュ)。設定されていれば打刻のたびに入力を求める。
  pinHash     String?
  pinFailures Int      @default(0)
  pinLockedUntil DateTime?
  createdAt   DateTime @default(now())

  shifts      Shift[]
  timeRecords TimeRecord[]

  @@unique([companyId, name])
}

// 時刻は勤務日の0時からの分数。日付をまたぐ勤務は endMinutes が1440(24:00)を超える。
model Shift {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id])
  date         DateTime
  startMinutes Int
  endMinutes   Int
  breakMinutes Int      @default(0)
  note         String?
  createdAt    DateTime @default(now())

  @@index([companyId, date])
}

// 出退勤の打刻。date は出勤した日(日本時間)で、日付をまたいで退勤しても出勤日の勤務として扱う。
// clockOut が空のあいだは勤務中、breakStartedAt が入っているあいだは休憩中。
model TimeRecord {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  staffId        String
  staff          Staff     @relation(fields: [staffId], references: [id])
  date           DateTime
  clockIn        DateTime
  clockOut       DateTime?
  breakMinutes   Int       @default(0)
  breakStartedAt DateTime?
  edited         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([companyId, date])
  @@index([staffId, clockOut])
}

model PayrollRun {
  id             String       @id @default(cuid())
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  month          String
  totalAmount    Int
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([companyId, month])
}

model AiExtraction {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id])
  sourceType          SourceType
  rawResponse         Json
  confidence          Float
  suggestedAccountCode String?
  status              AiExtractionStatus  @default(NEEDS_REVIEW)
  createdAt           DateTime            @default(now())

  expenseItem  ExpenseItem?
  invoice      Invoice?
}

model JournalEntry {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  date         DateTime
  description  String
  sourceType   SourceType
  status       JournalEntryStatus @default(PENDING_REVIEW)
  createdByAi  Boolean            @default(false)
  createdAt    DateTime           @default(now())

  lines             JournalLine[]
  expenseItem       ExpenseItem?
  invoice           Invoice?
  payment           Payment?
  fixedAsset        FixedAsset?        @relation("FixedAssetAcquisition")
  depreciationEntry DepreciationEntry? @relation("DepreciationPosting")
  posSales          PosSale[]
  stockMovement     StockMovement?
  bankTransaction   BankTransaction?
  payrollRun        PayrollRun?
  reimbursedReport  ExpenseReport?     @relation("ExpenseReimbursement")
  disposedAsset     FixedAsset?        @relation("FixedAssetDisposal")
  recurringPosting  RecurringPosting?
}

// 毎月決まった日に同じ仕訳を記帳する定期取引(家賃・リース料・借入金の返済など)
model RecurringEntry {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  description String
  // 1〜28日、または 0 = 月末
  dayOfMonth  Int
  startMonth  String
  endMonth    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  lines       RecurringLine[]
  postings    RecurringPosting[]
}

model RecurringLine {
  id               String         @id @default(cuid())
  recurringEntryId String
  recurringEntry   RecurringEntry @relation(fields: [recurringEntryId], references: [id], onDelete: Cascade)
  sortOrder        Int
  accountId        String
  account          Account        @relation(fields: [accountId], references: [id])
  debit            Int
  credit           Int
}

// 定期取引をどの月に記帳したか。同じ月に2回記帳しないための記録。
model RecurringPosting {
  id               String         @id @default(cuid())
  recurringEntryId String
  recurringEntry   RecurringEntry @relation(fields: [recurringEntryId], references: [id], onDelete: Cascade)
  month            String
  journalEntryId   String         @unique
  journalEntry     JournalEntry   @relation(fields: [journalEntryId], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([recurringEntryId, month])
}

// 操作ログ(誰が・いつ・何をしたか)
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  userName  String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Int          @default(0)
  credit         Int          @default(0)
  memo           String?
}

model AutomationRule {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  sourceType     SourceType
  minConfidence  Float      @default(0.9)
  maxAutoAmount  Int?
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())

  @@unique([companyId, sourceType])
}
